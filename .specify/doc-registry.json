{
  "version": 1,
  "allowed_statuses": [
    "maintained",
    "draft",
    "generated",
    "archived"
  ],
  "allowed_reviews": [
    "unreviewed",
    "code-reviewed",
    "client-input-derived",
    "client-confirmed",
    "operator-verified",
    "generated"
  ],
  "managed_roots": [
    "README.md",
    ".specify/memory/constitution.md",
    "specs/README.md",
    "specs/000-repo-governance",
    "biblio/README.md",
    "biblio/docs",
    "suppressor/README.md",
    "suppressor/docs"
  ],
  "exclude_globs": [
    ".agents/**",
    ".specify/templates/**"
  ],
  "documents": [
